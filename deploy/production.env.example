# Mẫu cấu hình cho deploy/docker-compose.prod.yml.
# Sao chép thành deploy/production.env TRÊN MÁY CHỦ rồi điền giá trị thật. Không bao giờ commit file đó.

# --- Tên miền của API (trỏ bản ghi DNS A về IP máy chủ) ---
API_DOMAIN=api.example.com
# Địa chỉ giao diện trên Vercel (được phép gọi API). Nhiều địa chỉ: ngăn cách bằng dấu phẩy.
CORS_ALLOWED_ORIGINS=https://your-project.vercel.app

# --- Database (chỉ dùng trong mạng nội bộ) ---
POSTGRES_USER=app
# Tạo: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
POSTGRES_DB=ai_eval

# --- Đăng nhập ---
# Tạo: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# --- Bảo vệ bản demo công khai ---
# Sau khi tạo xong tài khoản của mình, đặt false rồi chạy lại "up -d" để đóng đăng ký.
REGISTRATION_ENABLED=true
MAX_UPLOAD_SIZE_MB=10
MAX_DOCUMENTS_PER_USER=30
LOGIN_MAX_FAILURES=10
REGISTER_MAX_ATTEMPTS=5

# --- LLM (tùy chọn). Để trống LLM_BASE_URL: chạy chế độ trích đoạn, không cần key ---
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_PROVIDER_NAME=openai-compatible
