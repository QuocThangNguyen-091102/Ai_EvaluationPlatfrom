# Mẫu biến môi trường. Sao chép thành .env rồi điền giá trị thật.
# Không bao giờ commit file .env.

# --- Database (docker compose đọc các biến POSTGRES_* để tạo db) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_eval
# Cổng db công bố ra máy host, chỉ bind 127.0.0.1 (dùng khi chạy alembic hoặc pytest từ máy host)
DB_HOST_PORT=5432
# Chỉ dùng khi chạy backend trực tiếp trên máy host (trong docker compose, backend tự dựng URL với host "db")
DATABASE_URL=postgresql+psycopg://app:change-me@127.0.0.1:5432/ai_eval

# --- Backend ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
BACKEND_HOST_PORT=8000
# Dùng ở M3 trở đi
# Bắt buộc ít nhất 32 ký tự. Tạo: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
# Trong Docker, backend lưu file vào volume `uploads` (UPLOAD_DIR=/app/uploads do docker-compose đặt).
# Chỉ đặt UPLOAD_DIR khi chạy backend trực tiếp trên máy host (mặc định: thư mục `uploads` cạnh nơi chạy).
# UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20

# --- LLM (tùy chọn; embedding chạy cục bộ nên không cần key) ---
# Bất kỳ dịch vụ nào tương thích OpenAI Chat Completions (ví dụ Ollama chạy cục bộ: http://host.docker.internal:11434/v1).
# Để trống LLM_BASE_URL: hệ thống chạy chế độ trích đoạn (không gọi LLM).
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_PROVIDER_NAME=openai-compatible

# --- Frontend ---
FRONTEND_HOST_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
